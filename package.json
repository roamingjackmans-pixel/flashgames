{
  "name": "flashgames",
  "private": true,
  "version": "1.0.0",
  "description": "FlashGames: a daily 15-minute speedrun of one of Joseph's games with crazy modifiers. Friends compete for the day. Accounts and friends shared with Shoallhell.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "plans": "node tools/plans.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
